rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (Firebase Auth UID)
    // Fields:
    //   - uid: string (optional, matches userId) - User's Auth UID
    //   - email: string (optional, max 100 chars) - User's email
    //   - displayName: string (optional, max 100 chars) - Display name
    //   - username: string (optional, max 50 chars) - Unique username handle
    //   - photoURL: string (optional, max 2000 chars) - Avatar image URL
    //   - bio: string (optional, max 1000 chars) - User biography
    //   - followersCount: number (optional, >= 0) - Total followers count
    //   - followingCount: number (optional, >= 0) - Total following count
    //   - provider: string (optional, max 100 chars) - Authentication provider ID
    //   - createdAt: timestamp | string (optional) - Account creation timestamp
    //   - updatedAt: timestamp | string (optional) - Profile last update timestamp
    //
    // Collection: posts
    // Document ID: {postId} (unique post ID)
    // Fields:
    //   - authorId: string (required, immutable) - Firebase Auth UID of the author
    //   - title: string (optional, max 300 chars) - Post title
    //   - caption: string (optional, max 2500 chars) - Post caption (title or caption required)
    //   - status: string (required, enum) - ['approved', 'pending', 'draft', 'archived', 'published']
    //   - type: string (optional, enum) - ['reel', 'photo', 'ai-picture', 'video', 'image']
    //   - authorRole: string (optional, max 50 chars) - Role of author
    //   - authorName: string (optional, max 100 chars) - Author display name
    //   - authorUsername: string (optional, max 100 chars) - Author username
    //   - authorAvatar: string (optional, max 2000 chars) - Author avatar URL
    //   - mediaUrl: string (optional, max 500000 chars) - Primary media stream URL / data URL
    //   - coverUrl: string (optional, max 500000 chars) - Video cover thumbnail URL / data URL
    //   - url: string (optional, max 2000 chars) - Web / Drive link
    //   - fileId: string (optional, max 200 chars) - Google Drive / Storage file ID
    //   - driveFileId: string (optional, max 200 chars) - Google Drive file ID
    //   - c: string (optional, max 100 chars) - Client ID tag
    //   - b: string (optional, max 100 chars) - Branch name tag
    //   - album: string (optional, max 100 chars) - Album category
    //   - dur: string (optional, max 50 chars) - Video duration string
    //   - aspectRatio: number | string (optional, max 20 chars) - Video or photo aspect ratio
    //   - width: number (optional, >= 0) - Media pixel width
    //   - height: number (optional, >= 0) - Media pixel height
    //   - likes: number (optional, >= 0) - Likes counter
    //   - likesCount: number (optional, >= 0) - Likes counter
    //   - views: number (optional, >= 0) - View counter
    //   - viewsCount: number (optional, >= 0) - View counter
    //   - commentsCount: number (optional, >= 0) - Comments counter
    //   - downloads: number (optional, >= 0) - Download counter
    //   - tags: list of strings (optional, max 20 items) - Hashtags
    //   - date: string (optional, max 100 chars) - Display date string
    //   - createdAt: timestamp | number | string (optional, max 100 chars) - Post creation timestamp
    //   - updatedAt: timestamp | number | string (optional, max 100 chars) - Post update timestamp
    //   - hidden: bool (optional) - Post visibility flag
    //   - id: string (optional, max 100 chars) - Redundant post ID field
    //
    // Subcollection: posts/{postId}/comments
    // Document ID: {commentId}
    // Fields:
    //   - userId: string (required, immutable) - Commenter Auth UID
    //   - text: string (required, 1-500 chars) - Comment message text
    //   - createdAt: timestamp | number | string (optional, max 100 chars) - Comment creation timestamp
    //   - timestamp: timestamp | number (optional) - Comment epoch/timestamp
    //   - user: string (optional, max 100 chars) - Commenter username
    //   - username: string (optional, max 100 chars) - Commenter handle
    //   - authorUsername: string (optional, max 100 chars) - Commenter handle
    //   - avatar: string (optional, max 2000 chars) - Commenter avatar URL
    //   - authorName: string (optional, max 100 chars) - Commenter display name
    //   - postId: string (optional, max 100 chars) - Parent post ID
    //   - id: string (optional, max 100 chars) - Comment ID
    //   - time: string (optional, max 100 chars) - Display timestamp string
    //
    // Subcollection: posts/{postId}/likes
    // Document ID: {userId} (Firebase Auth UID of the liking user)
    // Fields:
    //   - userId: string (optional, matches document ID) - Liker UID
    //   - createdAt: timestamp (optional) - Like timestamp
    //   - likedAt: timestamp (optional) - Like timestamp
    //   - postId: string (optional, max 100 chars) - Liked post ID
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasOnly([
        'uid', 'email', 'displayName', 'username', 'photoURL', 'bio',
        'followersCount', 'followingCount', 'provider', 'createdAt', 'updatedAt'
      ]) &&
      (!('uid' in data) || (data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128)) &&
      (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
      (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
      (!('username' in data) || (data.username is string && data.username.size() <= 50)) &&
      (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000)) &&
      (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
      (!('followersCount' in data) || (data.followersCount is number && data.followersCount >= 0)) &&
      (!('followingCount' in data) || (data.followingCount is number && data.followingCount >= 0)) &&
      (!('provider' in data) || (data.provider is string && data.provider.size() <= 100)) &&
      (!('createdAt' in data) || (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 100))) &&
      (!('updatedAt' in data) || (data.updatedAt is timestamp || (data.updatedAt is string && data.updatedAt.size() <= 100)));
    }

    function isValidPostCore(data) {
      return data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128 &&
        data.status is string && data.status in ['approved', 'pending', 'draft', 'archived', 'published'] &&
        ((('title' in data && data.title is string && data.title.size() > 0 && data.title.size() <= 300) ||
          ('caption' in data && data.caption is string && data.caption.size() > 0 && data.caption.size() <= 2500))) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 300)) &&
        (!('caption' in data) || (data.caption is string && data.caption.size() <= 2500)) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 100)) &&
        (!('type' in data) || (data.type is string && data.type in ['reel', 'photo', 'ai-picture', 'video', 'image'])) &&
        (!('authorRole' in data) || (data.authorRole is string && data.authorRole.size() <= 50)) &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
        (!('authorUsername' in data) || (data.authorUsername is string && data.authorUsername.size() <= 100)) &&
        (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 2000));
    }

    function isValidPostMedia(data) {
      return (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 500000)) &&
        (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 500000)) &&
        (!('url' in data) || (data.url is string && data.url.size() <= 2000)) &&
        (!('fileId' in data) || (data.fileId is string && data.fileId.size() <= 200)) &&
        (!('driveFileId' in data) || (data.driveFileId is string && data.driveFileId.size() <= 200)) &&
        (!('c' in data) || (data.c is string && data.c.size() <= 100)) &&
        (!('b' in data) || (data.b is string && data.b.size() <= 100)) &&
        (!('album' in data) || (data.album is string && data.album.size() <= 100)) &&
        (!('dur' in data) || (data.dur is string && data.dur.size() <= 50)) &&
        (!('aspectRatio' in data) || data.aspectRatio is number || (data.aspectRatio is string && data.aspectRatio.size() <= 20)) &&
        (!('width' in data) || (data.width is number && data.width >= 0)) &&
        (!('height' in data) || (data.height is number && data.height >= 0));
    }

    function isValidPostMetrics(data) {
      return (!('likes' in data) || (data.likes is number && data.likes >= 0)) &&
        (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0)) &&
        (!('views' in data) || (data.views is number && data.views >= 0)) &&
        (!('viewsCount' in data) || (data.viewsCount is number && data.viewsCount >= 0)) &&
        (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0)) &&
        (!('downloads' in data) || (data.downloads is number && data.downloads >= 0)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
        (!('date' in data) || (data.date is string && data.date.size() <= 100)) &&
        (!('createdAt' in data) || (data.createdAt is timestamp || data.createdAt is number || (data.createdAt is string && data.createdAt.size() <= 100))) &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp || data.updatedAt is number || (data.updatedAt is string && data.updatedAt.size() <= 100))) &&
        (!('hidden' in data) || data.hidden is bool);
    }

    function isValidPost(data) {
      return data.keys().hasOnly([
        'id', 'authorId', 'authorRole', 'authorName', 'authorUsername', 'authorAvatar',
        'type', 'title', 'caption', 'status', 'mediaUrl', 'coverUrl', 'url',
        'fileId', 'driveFileId', 'c', 'b', 'album', 'dur', 'aspectRatio',
        'width', 'height', 'likes', 'likesCount', 'views', 'viewsCount',
        'commentsCount', 'downloads', 'tags', 'date', 'createdAt', 'updatedAt', 'hidden'
      ]) &&
      isValidPostCore(data) &&
      isValidPostMedia(data) &&
      isValidPostMetrics(data);
    }

    function isValidComment(data) {
      return data.keys().hasOnly([
        'id', 'userId', 'text', 'createdAt', 'timestamp', 'user', 'username',
        'authorUsername', 'avatar', 'authorName', 'postId', 'time'
      ]) &&
      data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
      data.text is string && data.text.size() > 0 && data.text.size() <= 500 &&
      (!('timestamp' in data) || data.timestamp is number || data.timestamp is timestamp) &&
      (!('createdAt' in data) || (data.createdAt is timestamp || data.createdAt is number || (data.createdAt is string && data.createdAt.size() <= 100))) &&
      (!('user' in data) || (data.user is string && data.user.size() <= 100)) &&
      (!('username' in data) || (data.username is string && data.username.size() <= 100)) &&
      (!('authorUsername' in data) || (data.authorUsername is string && data.authorUsername.size() <= 100)) &&
      (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 2000)) &&
      (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
      (!('postId' in data) || (data.postId is string && data.postId.size() <= 100)) &&
      (!('id' in data) || (data.id is string && data.id.size() <= 100)) &&
      (!('time' in data) || (data.time is string && data.time.size() <= 100));
    }

    function isValidLike(data) {
      return data.keys().hasOnly(['userId', 'createdAt', 'likedAt', 'postId']) &&
      (!('userId' in data) || (data.userId is string && data.userId == request.auth.uid)) &&
      (!('createdAt' in data) || data.createdAt is timestamp) &&
      (!('likedAt' in data) || data.likedAt is timestamp) &&
      (!('postId' in data) || (data.postId is string && data.postId.size() <= 100));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User profiles: public read, write restricted to profile owner
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && uidNotModified();
      allow delete: if false;
    }

    // Community uploads and public posts: public read, authenticated create
    match /posts/{postId} {
      allow read: if true;
      allow create: if isValidPost(request.resource.data) &&
        (!isAuthenticated() || request.resource.data.authorId == request.auth.uid);
      allow update: if (isOwner(resource.data.authorId) &&
        request.resource.data.authorId == resource.data.authorId &&
        isValidPost(request.resource.data)) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount', 'likes', 'likesCount', 'views', 'viewsCount']);
      allow delete: if isOwner(resource.data.authorId);

      // Comments subcollection: public read, public/authenticated create, author/post owner delete
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isValidComment(request.resource.data) &&
          (!isAuthenticated() || request.resource.data.userId == request.auth.uid);
        allow update: if isOwner(resource.data.userId) &&
          request.resource.data.userId == resource.data.userId &&
          isValidComment(request.resource.data);
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          (exists(/databases/$(database)/documents/posts/$(postId)) &&
           get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid)
        );
      }

      // Likes subcollection: public read, liking user write (create/update/delete)
      match /likes/{userId} {
        allow read: if true;
        allow create, update: if isOwner(userId) && isValidLike(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
